# Required for live mode.
ACCESS_TOKEN=replace_with_meta_access_token
AD_ACCOUNT_ID=act_123456789

# Optional but needed for business-level dataset/ad account actions.
BUSINESS_ID=123456789
META_API_VERSION=v21.0

# Optional override if the official CLI binary is not named "meta".
META_CLI_BIN=meta

# --- Sandbox-first safety (recommended while learning) ---
# Your Marketing API Sandbox ad account id. Calls behave like production but
# never deliver ads or spend money. See docs/SANDBOX_SETUP.md.
SANDBOX_AD_ACCOUNT_ID=act_sandbox123456789
# When 1, live runs target SANDBOX_AD_ACCOUNT_ID by default (until you unset it).
META_SANDBOX=1
# When 1, `apply --mode live` refuses unless the target is the sandbox account.
META_REQUIRE_SANDBOX=1

# --- ads_agent (LLM optimization agent; see docs/AGENT.md) ---
ANTHROPIC_API_KEY=sk-ant-replace_me
ADS_AGENT_WORKBOOK=data/current.xlsx
ADS_AGENT_MODE=mock
ADS_AGENT_REPORT_DIR=outputs/reports
ADS_AGENT_MODEL=claude-opus-4-8
# When 1, live applies refuse any action that would set a status to ACTIVE.
META_FORCE_PAUSED=1

# --- Rate-limit handling (Meta allows ~200 calls/hour) ---
# Retries on transient/rate-limit errors with exponential backoff.
META_RETRY_ATTEMPTS=5
META_RETRY_BASE_DELAY=2.0
# Optional fixed pause (seconds) between live actions; 0 disables.
META_MIN_INTERVAL=0
